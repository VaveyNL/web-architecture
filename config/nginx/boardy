server {
    server_name barsik.ai-info.ru;
    root /var/www/boardy;
    index index.html;
    access_log /var/log/nginx/boardy-access.log;
    error_log  /var/log/nginx/boardy-error.log;
    location / {
        try_files $uri $uri/ =404;
    }
    error_page 404 /404.html;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location ~* \.(css|js|png|jpg|jpeg|gif|ico|svg)$ {
        expires 7d;
        add_header Cache-Control "public, no-transform";
    }
    location /cgi-bin/ {
        gzip off;
        root /var/www/boardy;
        fastcgi_pass unix:/var/run/fcgiwrap.socket;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/boardy$fastcgi_script_name;
    }
    location = /submit {
        gzip off;
        fastcgi_pass unix:/var/run/fcgiwrap.socket;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/boardy/cgi-bin/submit.sh;
    }
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/barsik.ai-info.ru/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/barsik.ai-info.ru/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}
server {
    if ($host = barsik.ai-info.ru) {
        return 301 https://$host$request_uri;
    } # managed by Certbot
    listen 80;
    server_name barsik.ai-info.ru;
    return 404; # managed by Certbot
}
